# FarmSync Backend Environment Variables Template
# Copy this file to .env and configure local values.
# NEVER commit .env containing production secrets to version control.

# ==============================================================================
# DJANGO CORE CONFIGURATION
# ==============================================================================
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Default uses local SQLite file: backend/db.sqlite3
# For PostgreSQL: postgres://user:password@localhost:5432/farmsync_db
DATABASE_URL=sqlite:///db.sqlite3

# ==============================================================================
# CORS & FRONTEND CLIENT CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed frontend origins (React, Vite, Lovable SPA)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ==============================================================================
# EMAIL / SMTP ALERT CONFIGURATION (PLACEHOLDERS ONLY)
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_SENDER_EMAIL=alerts@example.com
SMTP_SENDER_PASSWORD=your-app-password-placeholder
SMTP_DEFAULT_RECIPIENTS=manager@example.com

# ==============================================================================
# HARDWARE & DETECTION SETTINGS
# ==============================================================================
CAMERA_DEVICE_INDEX=0
ENABLE_LOCAL_AUDIO_BUZZER=True
